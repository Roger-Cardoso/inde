option(INDE_STRICT_WARNINGS "Reject warnings in all INDE C++ targets" ON)
option(INDE_ENABLE_LTO "Optimize across translation units in Release" ON)
option(INDE_CODE_OPTIMIZATIONS "Apply measured memory/algorithm improvements" ON)
option(INDE_BUILD_CORE_TESTS "Build upstream core regression tests" OFF)
option(INDE_USE_GTK_PCH "Reuse parsed GTK headers when compiling the application" ON)
set(INDE_PGO_MODE "OFF" CACHE STRING "GCC profile phase: OFF, GENERATE or USE")
set_property(CACHE INDE_PGO_MODE PROPERTY STRINGS OFF GENERATE USE)
set(INDE_PGO_DIRECTORY "${CMAKE_BINARY_DIR}/pgo-data" CACHE PATH "GCC profile directory")
set(CMAKE_EXPORT_COMPILE_COMMANDS ON)
if(NOT CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
  message(FATAL_ERROR "This strict profile requires GCC or Clang")
endif()
if(INDE_ENABLE_LTO)
  include(CheckIPOSupported)
  check_ipo_supported(RESULT INDE_IPO_SUPPORTED OUTPUT INDE_IPO_ERROR)
  if(NOT INDE_IPO_SUPPORTED)
    message(FATAL_ERROR "LTO unavailable: ${INDE_IPO_ERROR}")
  endif()
  set(CMAKE_INTERPROCEDURAL_OPTIMIZATION_RELEASE ON)
  if(CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
    # Keep the GCC linker within the memory budget of ordinary author laptops.
    add_link_options("$<$<CONFIG:Release>:-flto=2>")
    # Tests reuse the O3 native half; the application links the LTO half.
    # This avoids repeating whole-program optimization in dozens of helpers.
    add_compile_options("$<$<CONFIG:Release>:-ffat-lto-objects>")
  endif()
endif()
if(NOT INDE_PGO_MODE MATCHES "^(OFF|GENERATE|USE)$")
  message(FATAL_ERROR "INDE_PGO_MODE must be OFF, GENERATE or USE")
endif()
if(NOT INDE_PGO_MODE STREQUAL "OFF")
  if(NOT CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
    message(FATAL_ERROR "This PGO workflow requires GCC")
  endif()
  if(NOT CMAKE_BUILD_TYPE STREQUAL "Release")
    message(FATAL_ERROR "PGO requires Release")
  endif()
  if(INDE_PGO_MODE STREQUAL "GENERATE")
    add_compile_options("-fprofile-generate=${INDE_PGO_DIRECTORY}" -fprofile-update=atomic)
    add_link_options("-fprofile-generate=${INDE_PGO_DIRECTORY}")
  else()
    file(GLOB_RECURSE INDE_PROFILES "${INDE_PGO_DIRECTORY}/*.gcda")
    if(NOT INDE_PROFILES)
      message(FATAL_ERROR "No PGO data. Build GENERATE, run representative workloads and exit normally first.")
    endif()
    add_compile_options("-fprofile-use=${INDE_PGO_DIRECTORY}" -fprofile-partial-training)
    add_link_options("-fprofile-use=${INDE_PGO_DIRECTORY}")
  endif()
endif()
add_compile_options(-Wall -Wextra -Wpedantic -Wconversion "$<$<CONFIG:Release>:-O3>")
if(INDE_STRICT_WARNINGS)
  add_compile_options(-Werror)
endif()
